<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>RE_CAT · 个人主页</title>

  <!-- MD3 风格字体：Roboto + Google Sans 替代 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

  <style>
    /* ============ MD3 基础设计令牌 (Design Tokens) ============ */
    :root {
      /* 主色 - MD3 蓝紫系 (可替换) */
      --md-primary: #6750A4;
      --md-on-primary: #FFFFFF;
      --md-primary-container: #EADDFF;
      --md-on-primary-container: #21005D;

      /* 表面色 */
      --md-surface: #FFFFFF;
      --md-surface-dim: #F7F5F2;
      --md-surface-container-lowest: #FFFFFF;
      --md-surface-container-low: #FAF9F7;
      --md-surface-container: #F3F1ED;
      --md-surface-container-high: #ECE9E4;
      --md-surface-container-highest: #E6E2DC;

      /* 文字 */
      --md-on-surface: #1D1B20;
      --md-on-surface-variant: #49454F;
      --md-outline: #79747E;
      --md-outline-variant: #CAC4D0;

      /* 圆角 */
      --md-corner-xs: 8px;
      --md-corner-s: 12px;
      --md-corner-m: 16px;
      --md-corner-l: 20px;
      --md-corner-xl: 28px;
      --md-corner-full: 9999px;

      /* 阴影 */
      --md-elevation-1: 0 1px 2px rgba(0,0,0,0.08), 0 1px 3px rgba(0,0,0,0.04);
      --md-elevation-2: 0 2px 4px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
      --md-elevation-3: 0 4px 8px rgba(0,0,0,0.06), 0 2px 4px rgba(0,0,0,0.04);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      height: 100%;
    }

    body {
      font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--md-surface-dim);
      color: var(--md-on-surface);
      display: flex;
      justify-content: center;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* ============ App 容器 ============ */
    .app {
      width: 100%;
      max-width: 480px;
      background: var(--md-surface);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
      box-shadow: 0 0 40px rgba(0,0,0,0.03);
    }

    /* ============ 页面 ============ */
    .page {
      flex: 1;
      display: none;
      flex-direction: column;
      padding: 28px 20px 24px;
      animation: mdFadeIn 0.28s cubic-bezier(0.2, 0, 0, 1);
    }

    .page.active {
      display: flex;
    }

    @keyframes mdFadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ============ 第一页：个人信息 ============ */
    .profile-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding-top: 8px;
    }

    /* 头像 - MD3 圆形 + 柔和高光 */
    .avatar {
      width: 128px;
      height: 128px;
      border-radius: var(--md-corner-full);
      background: var(--md-surface);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      overflow: hidden;
      box-shadow: var(--md-elevation-3);
      border: 4px solid var(--md-surface);
      outline: 1px solid var(--md-outline-variant);
      flex-shrink: 0;
    }

    .avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* 无图时的占位 */
    .avatar-placeholder {
      font-size: 3.4rem;
      font-weight: 500;
      color: var(--md-on-surface-variant);
      line-height: 1;
    }

    /* 用户名 - MD3 Display Small */
    .username {
      font-size: 2.05rem;
      font-weight: 500;
      letter-spacing: -0.01em;
      color: var(--md-on-surface);
      margin-bottom: 6px;
      line-height: 1.15;
    }

    /* 副标题 */
    .tagline {
      font-size: 0.92rem;
      font-weight: 400;
      color: var(--md-on-surface-variant);
      margin-bottom: 32px;
      line-height: 1.4;
      letter-spacing: 0.1px;
    }

    /* ============ 社交卡片列表 (MD3 List) ============ */
    .social-list {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .social-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 18px;
      background: var(--md-surface-container-low);
      border-radius: var(--md-corner-m);
      text-decoration: none;
      color: inherit;
      transition: background 0.18s ease, transform 0.12s ease;
      border: none;
      cursor: pointer;
      -webkit-user-select: none;
      user-select: none;
    }

    .social-item:hover {
      background: var(--md-surface-container);
    }

    .social-item:active {
      transform: scale(0.985);
      background: var(--md-surface-container-high);
    }

    /* 非链接项（如微信）不可点击 */
    .social-item.static {
      cursor: default;
    }

    .social-item.static:active {
      transform: none;
    }

    /* 左侧图标 + 标签 */
    .social-left {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-shrink: 0;
    }

    /* MD3 圆形图标背景 */
    .social-icon {
      width: 40px;
      height: 40px;
      border-radius: var(--md-corner-full);
      background: var(--md-primary-container);
      color: var(--md-on-primary-container);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
      font-weight: 600;
      flex-shrink: 0;
      letter-spacing: -0.02em;
    }

    .social-label {
      font-size: 1rem;
      font-weight: 500;
      color: var(--md-on-surface);
      letter-spacing: 0.1px;
    }

    /* 右侧 handle 文字 - 修复截断 */
    .social-handle {
      font-size: 0.88rem;
      font-weight: 400;
      color: var(--md-on-surface-variant);
      text-align: right;
      flex-shrink: 1;
      min-width: 0;
      line-height: 1.35;
      word-break: break-all;   /* 允许长邮箱换行 */
    }

    /* ============ 第二页：游戏页 ============ */
    .game-page {
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 40px 28px;
      gap: 0;
    }

    .game-icon-wrapper {
      width: 96px;
      height: 96px;
      border-radius: var(--md-corner-full);
      background: var(--md-primary-container);
      color: var(--md-on-primary-container);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 28px;
    }

    .game-icon-wrapper .material-symbols-rounded {
      font-size: 48px;
      font-variation-settings: 'FILL' 1, 'wght' 400;
    }

    .game-title {
      font-size: 1.75rem;
      font-weight: 500;
      letter-spacing: -0.01em;
      color: var(--md-on-surface);
      margin-bottom: 12px;
    }

    .game-desc {
      font-size: 0.95rem;
      color: var(--md-on-surface-variant);
      line-height: 1.55;
      max-width: 280px;
      margin-bottom: 36px;
    }

    /* MD3 Filled Button */
    .game-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--md-primary);
      color: var(--md-on-primary);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.95rem;
      letter-spacing: 0.3px;
      padding: 16px 28px;
      border-radius: var(--md-corner-full);
      border: none;
      transition: background 0.18s ease, transform 0.12s ease, box-shadow 0.18s ease;
      box-shadow: var(--md-elevation-1);
      cursor: pointer;
      min-height: 56px;
    }

    .game-button:hover {
      background: #7965AF;
      box-shadow: var(--md-elevation-2);
    }

    .game-button:active {
      transform: scale(0.97);
      box-shadow: none;
    }

    .game-button .material-symbols-rounded {
      font-size: 22px;
      font-variation-settings: 'FILL' 1, 'wght' 500;
    }

    .game-url {
      margin-top: 20px;
      font-size: 0.75rem;
      color: var(--md-outline);
      letter-spacing: 0.4px;
    }

    /* ============ MD3 底部导航栏 ============ */
    .bottom-nav {
      display: flex;
      align-items: stretch;
      justify-content: space-around;
      background: var(--md-surface-container);
      padding: 8px 0 calc(8px + env(safe-area-inset-bottom, 0px));
      width: 100%;
      position: sticky;
      bottom: 0;
      z-index: 10;
      border-top: 1px solid var(--md-outline-variant);
    }

    .nav-btn {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      background: transparent;
      border: none;
      font-family: inherit;
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.3px;
      color: var(--md-on-surface-variant);
      padding: 8px 0 6px;
      cursor: pointer;
      transition: color 0.18s ease;
      position: relative;
      -webkit-tap-highlight-color: transparent;
    }

    /* MD3 指示药丸 (active indicator) */
    .nav-btn .icon-pill {
      width: 64px;
      height: 32px;
      border-radius: var(--md-corner-full);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s ease;
      position: relative;
    }

    .nav-btn .material-symbols-rounded {
      font-size: 24px;
      font-variation-settings: 'FILL' 0, 'wght' 400;
      transition: font-variation-settings 0.2s ease;
      color: inherit;
    }

    .nav-btn.active {
      color: var(--md-on-surface);
      font-weight: 600;
    }

    .nav-btn.active .icon-pill {
      background: var(--md-primary-container);
    }

    .nav-btn.active .material-symbols-rounded {
      color: var(--md-on-primary-container);
      font-variation-settings: 'FILL' 1, 'wght' 500;
    }

    .nav-btn:active {
      transform: scale(0.96);
    }

    /* ============ 响应式微调 ============ */
    @media (max-width: 380px) {
      .page {
        padding: 22px 16px 20px;
      }
      .avatar {
        width: 108px;
        height: 108px;
      }
      .username {
        font-size: 1.8rem;
      }
      .social-item {
        padding: 12px 14px;
      }
      .social-icon {
        width: 36px;
        height: 36px;
        font-size: 0.85rem;
      }
      .social-label {
        font-size: 0.92rem;
      }
      .social-handle {
        font-size: 0.82rem;
      }
    }
  </style>
</head>
<body>

  <div class="app">
    <!-- ============ 第一页：个人信息 ============ -->
    <div class="page active" id="page-profile">
      <div class="profile-section">
        <!-- 头像：把 src 换成你的头像图片路径即可 -->
        <div class="avatar">
          <img src="avatar.png" alt="RE_CAT avatar">
          <!-- 如果暂时没有图片，可以删除上面的 <img>，改用下面的占位： -->
          <!-- <span class="avatar-placeholder">🐱</span> -->
        </div>

        <h1 class="username">RE_CAT</h1>
        <p class="tagline">digital creature · 偶尔写游戏</p>

        <!-- 社交链接列表 -->
        <div class="social-list">

          <!-- Bilibili -->
          <a href="https://space.bilibili.com/" class="social-item" target="_blank" rel="noopener noreferrer">
            <div class="social-left">
              <span class="social-icon">B</span>
              <span class="social-label">Bilibili</span>
            </div>
            <span class="social-handle">@ARE_CAT</span>
          </a>

          <!-- Weixin（展示用，不跳转） -->
          <div class="social-item static">
            <div class="social-left">
              <span class="social-icon">微</span>
              <span class="social-label">Weixin</span>
            </div>
            <span class="social-handle">@Re_Cat_Me</span>
          </div>

          <!-- Gmail -->
          <a href="mailto:arch.recat@gmail.com" class="social-item">
            <div class="social-left">
              <span class="social-icon">G</span>
              <span class="social-label">Gmail</span>
            </div>
            <span class="social-handle">arch.recat@gmail.com</span>
          </a>

          <!-- Telegram -->
          <a href="https://t.me/RE_CAT0" class="social-item" target="_blank" rel="noopener noreferrer">
            <div class="social-left">
              <span class="social-icon">TG</span>
              <span class="social-label">Telegram</span>
            </div>
            <span class="social-handle">@RE_CAT0</span>
          </a>

        </div>
      </div>
    </div>

    <!-- ============ 第二页：游戏页 ============ -->
    <div class="page game-page" id="page-game">
      <div class="game-icon-wrapper">
        <span class="material-symbols-rounded">sports_esports</span>
      </div>

      <h2 class="game-title">XF Game</h2>
      <p class="game-desc">我自己制作的小游戏<br>点击下方按钮直接开玩</p>

      <!-- 跳转至 xfast.cc.cd/game.html -->
      <a href="http://xfast.cc.cd/game.html" class="game-button" target="_blank" rel="noopener noreferrer">
        <span>进入游戏</span>
        <span class="material-symbols-rounded">arrow_forward</span>
      </a>

      <div class="game-url">xfast.cc.cd/game.html</div>
    </div>

    <!-- ============ MD3 底部导航栏 ============ -->
    <nav class="bottom-nav">
      <button class="nav-btn active" id="navProfile" aria-label="个人信息">
        <span class="icon-pill">
          <span class="material-symbols-rounded">person</span>
        </span>
        <span>我的</span>
      </button>

      <button class="nav-btn" id="navGame" aria-label="游戏">
        <span class="icon-pill">
          <span class="material-symbols-rounded">sports_esports</span>
        </span>
        <span>游戏</span>
      </button>
    </nav>
  </div>

  <script>
    (function () {
      const pageProfile = document.getElementById('page-profile');
      const pageGame = document.getElementById('page-game');
      const navProfile = document.getElementById('navProfile');
      const navGame = document.getElementById('navGame');

      function setActivePage(pageId) {
        pageProfile.classList.remove('active');
        pageGame.classList.remove('active');
        navProfile.classList.remove('active');
        navGame.classList.remove('active');

        if (pageId === 'profile') {
          pageProfile.classList.add('active');
          navProfile.classList.add('active');
        } else {
          pageGame.classList.add('active');
          navGame.classList.add('active');
        }

        // 切换页面时回到顶部
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      navProfile.addEventListener('click', () => setActivePage('profile'));
      navGame.addEventListener('click', () => setActivePage('game'));
    })();
  </script>
</body>
</html>