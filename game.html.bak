  const quizContent=document.getElementById('quizContent');
  const skipBtn=document.getElementById('skipBtn');
  const restartBtn=document.getElementById('restartBtn');
  const resultOverlay=document.getElementById('resultOverlay');
  const resultEmoji=document.getElementById('resultEmoji');
  const resultTitle=document.getElementById('resultTitle');
  const resultBody=document.getElementById('resultBody');
  const resultBtn=document.getElementById('resultBtn');

  // ============================================================
  // 工具
  // ============================================================
  function shuffle(arr){const a=[...arr];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
  function getFilteredQuestions(){
    if(currentMode==='grade')return questionBank.filter(q=>q.grade===currentFilter);
    return questionBank.filter(q=>q.topic===currentFilter);
  }
  function getAllGrades(){return [...new Set(questionBank.map(q=>q.grade))];}
  function getAllTopics(){return [...new Set(questionBank.map(q=>q.topic))];}

  // ============================================================
  // 正计时器
  // ============================================================
  function startTimer(){
    stopTimer();
    elapsedSeconds=0;
    updateTimerDisplay();
    timerInterval=setInterval(()=>{
      elapsedSeconds++;
      updateTimerDisplay();
    },1000);
  }
  function stopTimer(){
    if(timerInterval){clearInterval(timerInterval);timerInterval=null;}
  }
  function updateTimerDisplay(){
    const m=Math.floor(elapsedSeconds/60);
    const s=elapsedSeconds%60;
    timerValue.textContent=`${m}:${s.toString().padStart(2,'0')}`;
  }

  // ============================================================
  // 进度
  // ============================================================
  function updateProgress(){
    const total=questionQueue.length;
    const done=currentIndex;
    progressFill.style.width=(total>0?(done/total)*100:0)+'%';
  }

  // ============================================================
  // 渲染标签
  // ============================================================
  function renderChips(){
    topicChips.innerHTML='';
    const items=currentMode==='grade'?getAllGrades():getAllTopics();
    items.forEach(item=>{
      const btn=document.createElement('button');
      btn.className='chip'+(item===currentFilter?' active':'');
      btn.textContent=item;
      btn.addEventListener('click',()=>{
        currentFilter=item;
        renderChips();
        startSession();
      });
      topicChips.appendChild(btn);
    });
  }

  // ============================================================
  // 开始
  // ============================================================
  function startSession(){
    stopTimer();
    const filtered=getFilteredQuestions();
    if(filtered.length===0){
      quizContent.innerHTML='<div class="empty-state">该分类下暂无题目</div>';
      skipBtn.disabled=true;
      return;
    }
    questionQueue=shuffle(filtered);
    currentIndex=0;
    score=0;
    correctCount=0;
    comboCount=0;
    maxCombo=0;
    scoreValue.textContent='0';
    updateComboDisplay();
    updateProgress();
    loadQuestion();
  }

  // ============================================================
  // 加载题目
  // ============================================================
  function loadQuestion(){
    if(currentIndex>=questionQueue.length){showResult();return;}
    answered=false;
    comboIndicator.classList.remove('show');
    const q=questionQueue[currentIndex];
    const allOptions=shuffle([q.answer,...q.distractors]);

    quizContent.innerHTML=`
      <div class="source-label">📜 ${q.source}</div>
      <div class="poem-display" id="poemDisplay"></div>
      <div class="options-grid" id="optionsGrid"></div>
      <div class="feedback-message" id="feedbackMsg"></div>
    `;

    // 渲染诗句
    const poemDisplay=document.getElementById('poemDisplay');
    let safe=q.display.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    safe=safe.replace(/_{3,}/g,'<span class="poem-blank">______</span>');
    poemDisplay.innerHTML=safe;

    // 渲染选项
    const optionsGrid=document.getElementById('optionsGrid');
    allOptions.forEach(optText=>{
      const btn=document.createElement('button');
      btn.className='option-btn';
      btn.textContent=optText;
      const isCorrect=(optText===q.answer);
      btn.dataset.correct=isCorrect?'true':'false';
      btn.addEventListener('click',(e)=>handleOptionClick(btn,isCorrect,q,e));
      optionsGrid.appendChild(btn);
    });

    // 正计时
    startTimer();

    skipBtn.disabled=true;
    skipBtn.textContent='跳过';
    skipBtn.onclick=()=>{
      if(!answered){
        answered=true;
        stopTimer();
        document.querySelectorAll('.option-btn').forEach(b=>{
          b.disabled=true;
          if(b.dataset.correct==='true')b.classList.add('correct');
        });
        const fb=document.getElementById('feedbackMsg');
        if(fb){fb.textContent='已跳过';fb.className='feedback-message error';}
        comboCount=0;
        updateComboDisplay();
      }
      skipBtn.disabled=false;
      skipBtn.textContent='下一题';
      skipBtn.onclick=()=>nextQuestion();
    };
    updateProgress();
  }

  // ============================================================
  // 点击选项
  // ============================================================
  function handleOptionClick(btn,isCorrect,q,event){
    if(answered)return;
    answered=true;
    stopTimer();

    document.querySelectorAll('.option-btn').forEach(b=>{
      b.disabled=true;
      if(b.dataset.correct==='true')b.classList.add('correct');
      else if(b===btn&&!isCorrect)b.classList.add('wrong');
    });

    const fb=document.getElementById('feedbackMsg');

    if(isCorrect){
      correctCount++;
      comboCount++;
      maxCombo=Math.max(maxCombo,comboCount);
      const comboBonus=Math.min(comboCount-1,5)*3;
      const gain=10+comboBonus;
      score+=gain;
      scoreValue.textContent=score;
      btn.classList.add('correct');
      btn.classList.remove('wrong');
      fb.textContent=`正确 +${gain}`;
      fb.className='feedback-message success';
      showFloatScore('+'+gain);
      if(comboCount>=3)spawnConfetti(12);
    }else{
      comboCount=0;
      fb.textContent='答错了';
      fb.className='feedback-message error';
    }

    updateComboDisplay();
    skipBtn.disabled=false;
    skipBtn.textContent='下一题';
    skipBtn.onclick=()=>nextQuestion();
  }

  function nextQuestion(){
    currentIndex++;
    updateProgress();
    loadQuestion();
  }

  function updateComboDisplay(){
    if(comboCount>=2){
      comboValue.textContent=comboCount;
      comboIndicator.classList.add('show');
    }else{
      comboIndicator.classList.remove('show');
    }
  }

  // ============================================================
  // 特效
  // ============================================================
  function showFloatScore(text){
    const el=document.createElement('div');
    el.className='float-score';
    el.textContent=text;
    el.style.left=(window.innerWidth/2-30)+'px';
    el.style.top=(window.innerHeight/2-60)+'px';
    document.body.appendChild(el);
    setTimeout(()=>el.remove(),600);
  }

  function spawnConfetti(count){
    const colors=['#6750A4','#625B71','#7D5260','#FFD8E4','#EADDFF'];
    for(let i=0;i<count;i++){
      const c=document.createElement('div');
      c.className='confetti';
      c.style.left=Math.random()*100+'%';
      c.style.top='-10px';
      c.style.background=colors[Math.floor(Math.random()*colors.length)];
      c.style.borderRadius=Math.random()>0.5?'50%':'2px';
      c.style.animationDelay=(Math.random()*0.3)+'s';
      document.body.appendChild(c);
      setTimeout(()=>c.remove(),2000);
    }
  }

  // ============================================================
  // 结算
  // ============================================================
  function showResult(){
    stopTimer();
    const total=questionQueue.length;
    const accuracy=total>0?Math.round((correctCount/total)*100):0;
    const usedTime=elapsedSeconds;

    let emoji,title;
    if(accuracy>=90){emoji='🏆';title='诗仙级表现';}
    else if(accuracy>=70){emoji='🥈';title='诗圣级表现';}
    else if(accuracy>=50){emoji='🥉';title='诗童级表现';}
    else{emoji='📖';title='继续加油';}

    resultEmoji.textContent=emoji;
    resultTitle.textContent=title;
    resultBody.innerHTML=`
      总题数 <strong>${total}</strong> · 答对 <strong>${correctCount}</strong> · 正确率 <strong>${accuracy}%</strong><br>
      最高连击 <strong>${maxCombo}</strong> · 总得分 <strong>${score}</strong><br>
      用时 <strong>${Math.floor(usedTime/60)}分${usedTime%60}秒</strong>
    `;
    resultOverlay.classList.add('show');
  }

  // ============================================================
  // 初始化
  // ============================================================
  function init(){
    modeSelector.addEventListener('click',(e)=>{
      const btn=e.target.closest('.segment-btn');
      if(!btn)return;
      const mode=btn.dataset.mode;
      if(mode===currentMode)return;
      currentMode=mode;
      document.querySelectorAll('.segment-btn').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter=mode==='grade'?getAllGrades()[0]:getAllTopics()[0];
      renderChips();
      startSession();
    });

    restartBtn.addEventListener('click',()=>{
      resultOverlay.classList.remove('show');
      startSession();
    });

    resultBtn.addEventListener('click',()=>{
      resultOverlay.classList.remove('show');
      startSession();
    });

    renderChips();
    startSession();
  }

  init();
})();
</script>
</body>
</html>